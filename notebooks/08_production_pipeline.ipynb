    "# 08 — Production Inference Pipeline\n",
    "\n",
    "**Author:** Sherif Abd El-Rady\n",
    "\n",
    "**Objective:** Package the full training and inference workflow into clean, reusable functions that can be called from a CLI, a REST API, or a batch script — with no notebook dependency.\n",
    "\n",
    "This notebook demonstrates both the training flow (one-time) and the inference flow (per-image) using the same `defectdetect` package.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, time\n",
    "from pathlib import Path\n",
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "from tqdm import tqdm\n",
    "\n",
    "SRC = Path('..') / 'src'\n",
    "if str(SRC.resolve()) not in sys.path:\n",
    "    sys.path.insert(0, str(SRC.resolve()))\n",
    "\n",
    "from defectdetect import FeatureExtractor, MemoryBank, AnomalyEvaluator\n",
    "from defectdetect.scorer import AnomalyScorer\n",
    "\n",
    "ROOT   = Path('..').resolve()\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'Device: {DEVICE}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 8.1  Training function (runs once per product type) ───────────────────────\n",
    "def train_patchcore(\n",
    "    train_image_dir: Path,\n",
    "    bank_output_path: Path,\n",
    "    *,\n",
    "    layers: list = None,\n",
    "    input_size: int = 224,\n",
    "    sampling_ratio: float = 0.01,\n",
    "    projection_dim: int = 128,\n",
    "    batch_size: int = 8,\n",
    "    device: str = 'cpu',\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Extract features from all normal images and build a coreset memory bank.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    train_image_dir   : directory of normal-only training images\n",
    "    bank_output_path  : where to save the fitted MemoryBank\n",
    "    layers            : WideResNet layer names to hook (default: layer2 + layer3)\n",
    "    sampling_ratio    : coreset fraction (0.01 = 1%)\n",
    "    projection_dim    : k-NN projection dimension\n",
    "    batch_size        : images per GPU batch\n",
    "    device            : 'cpu' or 'cuda'\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    dict with keys: n_train_images, n_patches, bank_size, fit_time_s\n",
    "    \"\"\"\n",
    "    t0    = time.perf_counter()\n",
    "    layers = layers or ['layer2', 'layer3']\n",
    "\n",
    "    extractor = FeatureExtractor(layers=layers, input_size=input_size, device=device)\n",
    "    paths = sorted(train_image_dir.glob('*.png')) + sorted(train_image_dir.glob('*.jpg'))\n",
    "\n",
    "    all_patches = []\n",
    "    for i in tqdm(range(0, len(paths), batch_size), desc='Training', leave=False):\n",
    "        imgs = [cv2.imread(str(p)) for p in paths[i:i+batch_size]]\n",
    "        imgs = [img for img in imgs if img is not None]\n",
    "        if not imgs: continue\n",
    "        batch = extractor.preprocess(imgs)\n",
    "        pat, _ = extractor.extract_patches(batch)\n",
    "        all_patches.append(pat)\n",
    "\n",
    "    all_patches = np.vstack(all_patches)\n",
    "    bank = MemoryBank(sampling_ratio=sampling_ratio, projection_dim=projection_dim)\n",
    "    bank.fit(all_patches)\n",
    "    bank_output_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    bank.save(bank_output_path)\n",
    "\n",
    "    return {\n",
    "        'n_train_images': len(paths),\n",
    "        'n_patches': len(all_patches),\n",
    "        'bank_size': bank.size,\n",
    "        'fit_time_s': round(time.perf_counter() - t0, 2),\n",
    "    }\n",
    "\n",
    "\n",
    "print('train_patchcore() defined')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 8.2  Inference function (called per image in production) ──────────────────\n",
    "def predict_patchcore(\n",
    "    image: np.ndarray,\n",
    "    bank: MemoryBank,\n",
    "    extractor: FeatureExtractor,\n",
    "    scorer: AnomalyScorer,\n",
    "    threshold: float | None = None,\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Score a single BGR image and return anomaly score + map.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    image     : np.ndarray (H, W, 3) BGR uint8\n",
    "    bank      : fitted MemoryBank\n",
    "    extractor : initialised FeatureExtractor\n",
    "    scorer    : AnomalyScorer\n",
    "    threshold : float or None — if set, adds 'is_anomaly' bool to result\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    dict with keys: score, anomaly_map, is_anomaly (optional), inference_ms\n",
    "    \"\"\"\n",
    "    t0 = time.perf_counter()\n",
    "    batch   = extractor.preprocess([image])\n",
    "    patches, sp = extractor.extract_patches(batch)\n",
    "    ps      = bank.score(patches, k=1)\n",
    "    score, amap = scorer.compute(ps, sp, n_images=1)\n",
    "    dt = (time.perf_counter() - t0) * 1000\n",
    "\n",
    "    result = {\n",
    "        'score':       float(score[0]),\n",
    "        'anomaly_map': amap[0],\n",
    "        'inference_ms': round(dt, 2),\n",
    "    }\n",
    "    if threshold is not None:\n",
    "        result['is_anomaly'] = bool(result['score'] >= threshold)\n",
    "    return result\n",
    "\n",
    "\n",
    "print('predict_patchcore() defined')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 8.3  End-to-end demo ──────────────────────────────────────────────────────\n",
    "MVTEC    = ROOT / 'data' / 'mvtec'\n",
    "CATEGORY = 'bottle'\n",
    "if not (MVTEC / CATEGORY / 'train' / 'good').exists():\n",
    "    MVTEC = ROOT / 'data' / 'synthetic'; CATEGORY = ''\n",
    "\n",
    "base     = MVTEC / CATEGORY if CATEGORY else MVTEC\n",
    "BANK_DIR = ROOT / 'reports' / 'memory_banks'\n",
    "BANK_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Load pre-built bank (from Notebook 04)\n",
    "bank_paths = sorted(BANK_DIR.glob('*.pkl'))\n",
    "if bank_paths:\n",
    "    bank = MemoryBank.load(bank_paths[-1])\n",
    "    print(f'Loaded existing bank: {bank.size} entries')\n",
    "else:\n",
    "    print('Building memory bank from scratch...')\n",
    "    stats = train_patchcore(\n",
    "        train_image_dir=base / 'train' / 'good',\n",
    "        bank_output_path=BANK_DIR / 'demo_bank.pkl',\n",
    "        device=DEVICE,\n",
    "    )\n",
    "    print(stats)\n",
    "    bank = MemoryBank.load(BANK_DIR / 'demo_bank.pkl')\n",
    "\n",
    "extractor = FeatureExtractor(layers=['layer2','layer3'], input_size=224, device=DEVICE)\n",
    "scorer    = AnomalyScorer(image_size=(224, 224), gaussian_sigma=4.0)\n",
    "THRESHOLD = 0.5   # use the optimal value from Notebook 06 here\n",
    "\n",
    "# Score a defect image\n",
    "test_paths = [p for cls in (base/'test').iterdir() if cls.name != 'good'\n",
    "              for p in sorted(cls.glob('*.png'))[:1]]\n",
    "\n",
    "fig, axes = plt.subplots(1, min(3, len(test_paths)), figsize=(14, 4))\n",
    "if len(test_paths) == 1: axes = [axes]\n",
    "\n",
    "for ax, p in zip(axes, test_paths[:3]):\n",
    "    img = cv2.imread(str(p))\n",
    "    res = predict_patchcore(img, bank, extractor, scorer, threshold=THRESHOLD)\n",
    "    amap_norm = (res['anomaly_map'] - res['anomaly_map'].min()) / (res['anomaly_map'].max() - res['anomaly_map'].min() + 1e-8)\n",
    "    overlay   = scorer.overlay(img, amap_norm, alpha=0.55)\n",
    "    ax.imshow(cv2.cvtColor(overlay, cv2.COLOR_BGR2RGB))\n",
    "    label = '⚠ ANOMALY' if res.get('is_anomaly') else '✓ NORMAL'\n",
    "    ax.set_title(f'{p.parent.name}/{p.name}\\nscore={res[\"score\"]:.3f}  {label}\\n{res[\"inference_ms\"]:.1f}ms', fontsize=7)\n",
    "    ax.axis('off')\n",
    "\n",
    "plt.suptitle('Production Pipeline: predict_patchcore() output', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
